# Backend only — never expose these to the browser.
WKALA_API_KEY=
SESSION_SECRET=
ALLOWED_ORIGIN=http://localhost:8501
COOKIE_SECURE=
BUDDY_STORE=./data/store.json

# Optional: attach a registered profile and MCP server by ID.
WKALA_PROFILE_ID=
WKALA_MCP_SERVER_ID=

# UI
BUDDY_MODE=llm
WKALA_BACKEND_URL=

# LLM mode only
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# --- model key (optional) ---------------------------------------------------
# DeepSeek is OpenAI-compatible: same client, different base_url.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
